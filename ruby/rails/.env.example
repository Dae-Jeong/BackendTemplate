# Copy to .env only if your shell tooling loads env files; Rails does not load it automatically.
APP_NAME="Backend Template Rails"
APP_ENVIRONMENT=local
SERVER_HOST=127.0.0.1
SERVER_PORT=18088
RAILS_MAX_THREADS=3
DB_POOL_SIZE=5
DB_BUSY_TIMEOUT_MILLISECONDS=5000
DB_PRIMARY_PATH=storage/development.sqlite3
