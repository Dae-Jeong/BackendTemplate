# 이 파일을 .env로 복사하고 필요한 값만 변경합니다.
# 프로세스 환경변수 > .env > Settings 기본값 순서로 적용합니다.
APP_NAME=Backend Template FastCRUD
SERVICE_VERSION=0.1.0
APP_ENVIRONMENT=local
SERVER_HOST=127.0.0.1
SERVER_PORT=18092
# Uvicorn이 진행 중 요청을 기다리는 시간입니다. 자원 정리의 전체 제한은 아닙니다.
SHUTDOWN_TIMEOUT_SECONDS=15
# debug / info / warning / error / critical
LOG_LEVEL=info
# 비우면 DB를 사용하지 않습니다. 부모 디렉터리는 실행 전에 생성합니다.
# 로컬: sqlite+aiosqlite:///./data/reservations.db
DB_PRIMARY_URL=
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=2
DB_SQLITE_BUSY_TIMEOUT_SECONDS=2
